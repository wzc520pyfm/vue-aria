{
  "name": "vue-stately",
  "version": "0.0.1",
  "description": "Vue 3 state management hooks for vue-aria, ported from react-stately.",
  "keywords": ["vue", "state", "aria"],
  "license": "Apache-2.0",
  "author": "wzc520pyfm",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "development": "./exports/index.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "development": "./exports/*.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "exports", "src"],
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@internationalized/number": "^3.6.9",
    "@internationalized/string": "^3.2.10"
  },
  "devDependencies": {
    "vue": "^3.5.13"
  },
  "publishConfig": {
    "access": "public"
  }
}
